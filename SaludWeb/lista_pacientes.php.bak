<?php
ini_set('display_errors', 1);
ini_set('display_startup_errors', 1);
error_reporting(E_ALL);

session_start();
require_once __DIR__ . '/db.php';

$buscar = trim($_GET['buscar'] ?? '');
$mensaje = '';
$pacientes = [];
$stats = [
    'total_pacientes' => 0,
    'recetas_activas' => 0,
    'criticos' => 0,
    'pendientes' => 0,
    'promedio_dolor' => 0,
];

try {
    $sql = "
        SELECT p.*, o.nombre_obra,
            (
                SELECT COUNT(*) FROM prescripciones pr
                WHERE pr.id_paciente = p.id
                  AND pr.estado = 'activa'
            ) AS recetas_activas,
            t.nivel_gravedad,
            t.fecha AS fecha_ult_triage
        FROM pacientes p
        LEFT JOIN obras_sociales o ON p.id_obra_social = o.id
        LEFT JOIN (
            SELECT tr1.id_paciente, tr1.nivel_gravedad, tr1.fecha
            FROM triages tr1
            INNER JOIN (
                SELECT id_paciente, MAX(fecha) AS fecha_max
                FROM triages
                GROUP BY id_paciente
            ) tr2 ON tr1.id_paciente = tr2.id_paciente
                AND tr1.fecha = tr2.fecha_max
        ) t ON p.id = t.id_paciente
        WHERE p.activo = 1
    ";

    $params = [];
    if ($buscar !== '') {
        $sql .= " AND (p.nombre LIKE ? OR p.dni LIKE ? )";
        $params[] = "%$buscar%";
        $params[] = "%$buscar%";
    }

    $sql .= " ORDER BY t.nivel_gravedad DESC, p.nombre ASC";

    $stmt = $pdo->prepare($sql);
    $stmt->execute($params);
    $pacientes = $stmt->fetchAll(PDO::FETCH_ASSOC);

    $statsStmt = $pdo->query("SELECT COUNT(*) AS total_pacientes FROM pacientes WHERE activo = 1");
    $stats['total_pacientes'] = (int)$statsStmt->fetchColumn();

    $statsStmt = $pdo->query("SELECT COUNT(*) FROM prescripciones WHERE estado = 'activa'");
    $stats['recetas_activas'] = (int)$statsStmt->fetchColumn();

    $statsQuery = "
        SELECT
            SUM(IF(t.nivel_gravedad >= 8, 1, 0)) AS criticos,
            SUM(IF(t.nivel_gravedad IS NULL OR t.nivel_gravedad < 8, 1, 0)) AS pendientes,
            AVG(t.nivel_gravedad) AS promedio_dolor
        FROM pacientes p
        LEFT JOIN (
            SELECT tr1.id_paciente, tr1.nivel_gravedad, tr1.fecha
            FROM triages tr1
            INNER JOIN (
                SELECT id_paciente, MAX(fecha) AS fecha_max
                FROM triages
                GROUP BY id_paciente
            ) tr2 ON tr1.id_paciente = tr2.id_paciente
                AND tr1.fecha = tr2.fecha_max
        ) t ON p.id = t.id_paciente
        WHERE p.activo = 1
    ";
    $statsStmt = $pdo->query($statsQuery);
    $row = $statsStmt->fetch(PDO::FETCH_ASSOC);
    if ($row) {
        $stats['criticos'] = (int)$row['criticos'];
        $stats['pendientes'] = (int)$row['pendientes'];
        $stats['promedio_dolor'] = $row['promedio_dolor'] !== null ? round((float)$row['promedio_dolor'], 1) : 0;
    }
} catch (Exception $e) {
    $mensaje = 'Error de consulta: ' . $e->getMessage();
}
?>
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
