        .search{background:var(--card);padding:12px;border-radius:12px;box-shadow:0 6px 20px rgba(2,6,23,0.06);}
        .grid{display:grid;grid-template-columns:1fr 320px;gap:20px}
        .panel{background:var(--card);padding:18px;border-radius:12px;box-shadow:0 8px 30px rgba(15,23,42,0.06)}
        .cards{display:flex;gap:12px;margin-bottom:12px}
        .card{flex:1;padding:14px;border-radius:10px;background:#f8fafc}
        table{width:100%;border-collapse:collapse;margin-top:12px}
        th,td{padding:10px;border:1px solid #e6edf3;text-align:left}
        th{background:#f1f5f9}
        .actions a{display:inline-block;padding:8px 12px;border-radius:8px;text-decoration:none;color:#fff;background:var(--accent);}
        .badge{display:inline-block;padding:6px 10px;border-radius:999px;background:#eef2ff;color:var(--accent);font-weight:700}
    </style>
</head>
<body>
    <div class="wrap">
        <header>
            <h1>SaludWEB Pro <small style="font-size:12px;color:var(--muted)">— Lista de Atención</small></h1>
            <div class="actions">
                <a href="registro_paciente.php">Registrar Nuevo Paciente</a>
            </div>
        </header>

        <div class="search panel">
            <form method="get" action="lista">
                <input type="text" name="buscar" placeholder="Buscar por nombre o DNI..." value="<?php echo htmlspecialchars($buscar); ?>" style="width:100%;padding:12px;border-radius:8px;border:1px solid #e6edf3">
            </form>
        </div>

        <div class="grid" style="margin-top:18px">
            <div>
                <div class="cards">
                    <div class="card">
                        <strong>TOTAL PACIENTES</strong>
                        <div style="font-size:20px;margin-top:6px"><?php echo $stats['total_pacientes']; ?></div>
                    </div>
                    <div class="card">
                        <strong>RECETAS ACTIVAS</strong>
                        <div style="font-size:20px;margin-top:6px"><?php echo $stats['recetas_activas']; ?></div>
                    </div>
                    <div class="card">
                        <strong>CASOS CRÍTIICOS</strong>
                        <div style="font-size:20px;margin-top:6px"><?php echo $stats['criticos']; ?></div>
                    </div>
                </div>

                <div class="panel">
                    <h2 style="margin:0 0 12px">Pacientes Registrados</h2>
                    <?php if ($mensaje): ?>
                        <div style="padding:10px;background:#fee2e2;border-radius:8px;color:#991b1b;margin-bottom:12px"><?php echo htmlspecialchars($mensaje); ?></div>
                    <?php endif; ?>
                    <table>
                        <thead>
                            <tr>
                                <th style="width:60px">ID</th>
                                <th>Nombre</th>
                                <th style="width:160px">DNI</th>
                                <th style="width:120px">Obra Social</th>
                                <th style="width:140px">Último Triage</th>
                            </tr>
                        </thead>
                        <tbody>
                            <?php if (count($pacientes) === 0): ?>
                                <tr><td colspan="5">No hay pacientes para mostrar.</td></tr>
                            <?php else: ?>
                                <?php foreach ($pacientes as $p): ?>
                                    <tr>
                                        <td><?php echo htmlspecialchars($p['id']); ?></td>
                                        <td><?php echo htmlspecialchars($p['nombre']); ?></td>
                                        <td><?php echo htmlspecialchars($p['dni']); ?></td>
                                        <td><?php echo htmlspecialchars($p['nombre_obra'] ?? 'Particular'); ?></td>
                                        <td><?php echo htmlspecialchars($p['fecha_ult_triage'] ?? '-'); ?></td>
                                    </tr>
                                <?php endforeach; ?>
                            <?php endif; ?>
                        </tbody>
                    </table>
                </div>
            </div>

            <aside>
                <div class="panel">
                    <h3>Indicadores</h3>
                    <p><span class="badge"><?php echo $stats['criticos']; ?></span> Críticos</p>
                    <p><strong>Pendientes:</strong> <?php echo $stats['pendientes']; ?></p>
                    <p><strong>Dolor promedio:</strong> <?php echo $stats['promedio_dolor']; ?></p>
                    <hr>
                    <p style="font-size:13px;color:var(--muted)">Acciones rápidas</p>
                    <p><a href="registro_paciente.php">Nuevo paciente</a></p>
                    <p><a href="papelera.php">Ver papelera</a></p>
                </div>
